}

<div class="row">
    <SideNavSlider />
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="ribbon-1">
                            <div class="ribbon-box">
                                <h3><div class="ribbon ribbon-mark bg-primary">@Localizer["PayABill"]</div></h3>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="tab-content" id="profile-tabContent">
                                            <div class="tab-pane fade show active">
