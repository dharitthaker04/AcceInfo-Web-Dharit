                                                                <div class="card-body">
                                                                    <dl class="row mb-0">
                                                                        <dt class="col-sm-4">@Localizer["PayFrom"]</dt>
                                                                        <dd class="col-sm-8">@SelectedFromSummary</dd>
                                                                        <dt class="col-sm-4">@Localizer["PayTo"]</dt>
                                                                        <dd class="col-sm-8">@SelectedToSummary</dd>

                                                                        <dt class="col-sm-4">@Localizer["Amount"]</dt>
                                                                        <dd class="col-sm-8 text-primary font-weight-bold">@($"{Convert.ToDecimal(Model.Amount):C2}")</dd>

                                                                        <dt class="col-sm-4">@Localizer["Frequency"]</dt>
                                                                        <dd class="col-sm-8">@Model.Frequency</dd>

                                                                        @if (Model.Frequency == "Once")
                                                                        {
                                                                            <dt class="col-sm-4">@Localizer["Date"]</dt>
                                                                            <dd class="col-sm-8">@Model.Date?.ToString("yyyy-MM-dd")</dd>
                                                                        }
                                                                        else
                                                                        {
                                                                            <dt class="col-sm-4">@Localizer["StartDate"]:</dt>
                                                                            <dd class="col-sm-8">@Model.StartDate?.ToString("yyyy-MM-dd")</dd>
                                                                            <dt class="col-sm-4">@Localizer["EndDate"]:</dt>
                                                                            <dd class="col-sm-8">@Model.EndDate?.ToString("yyyy-MM-dd")</dd>
                                                                        }

                                                                        <dt class="col-sm-4">@Localizer["Memo"]</dt>
                                                                        <dd class="col-sm-8">@Model.Memo</dd>
                                                                    </dl>
                                                                    <div class="text-right mt-3">
                                                                        <div class="row justify-content-end">
                                                                            <div class="col-md-3">
                                                                                <button class="btn btn-outline-primary w-100" @onclick="BackToForm">@Localizer["Back"]</button>
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <button class="btn btn-primary w-100" @onclick="SubmitPayBill">@Localizer["ConfirmPayABill"]</button>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
