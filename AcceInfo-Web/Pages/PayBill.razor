                                                                    <button class="btn btn-primary w-100" @onclick="@(() => NavigationManager.NavigateTo(NavigationManager.Uri, true))">Finish</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else if (ShowConfirmation)
                                                {
                                                    <div class="row justify-content-center">
                                                        <div class="col-md-12">

