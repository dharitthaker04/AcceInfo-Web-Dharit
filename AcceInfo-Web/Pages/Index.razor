                        <dt class="col-sm-6">Authorized Limit:</dt>
                        <dd class="col-sm-6">$0.00</dd>

                        <dt class="col-sm-6">Transit Number:</dt>
                        <dd class="col-sm-6">50138</dd>

                        <dt class="col-sm-6">Institution Number:</dt>
                        <dd class="col-sm-6">889</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
